+__device__ __forceinline__ int get_revocation_state(
+    RuntimeConfig const &config) {
+  if (config.revocation_control == nullptr) {
+    return static_cast<int>(RevocationState::RUNNING);
+  }
+  int state;
+  asm volatile("ld.acquire.gpu.s32 %0, [%1];"
+               : "=r"(state)
+               : "l"(&config.revocation_control->state)
+               : "memory");
+  return state;
+}
+
+__device__ __forceinline__ int increment_stopped_scheduler_count(int *count) {
+  int old_count;
+  asm volatile("atom.add.acq_rel.gpu.s32 %0, [%1], 1;"
+               : "=r"(old_count)
+               : "l"(count)
+               : "memory");
+  return old_count;
+}
+
+__device__ __forceinline__ void publish_revocation_state_device(int *state,
+                                                                 int value) {
+  asm volatile("st.release.gpu.s32 [%0], %1;"
+               :
+               : "l"(state), "r"(value)
+               : "memory");
+}
